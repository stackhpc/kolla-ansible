auth_enabled: false

server:
  http_listen_port: 3100
  grpc_listen_port: 9096

common:
  instance_addr: {{ 'api' | kolla_address }}
  path_prefix: /var/lib/loki
  replication_factor: 2
  ring:
    kvstore:
      store: memberlist
  storage:
{% if loki_storage_type == 's3' %}
    s3:
      endpoint: {{ loki_s3_endpoint }}
      bucketnames: {{ loki_s3_bucket }}
      access_key_id: {{ loki_s3_access_key }}
      secret_access_key: {{ loki_s3_secret_key }}
      s3forcepathstyle: true
{% elif loki_storage_type == 'filesystem' %}
    filesystem:
      chunks_directory: /var/lib/loki/chunks
      rules_directory: /var/lib/loki/rules
{% endif %}

memberlist:
  join_members:
{% for host in groups['loki'] %}
    - {{ 'api' | kolla_address(host) }}
{% endfor %}

schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: {{ 's3' if loki_storage_type == 's3' else 'filesystem' }}
      schema: v13
      index:
        prefix: index_
        period: 24h

ingester:
  chunk_idle_period: {{ loki_ingester_chunk_idle_period }}
  max_chunk_age: {{ loki_ingester_max_chunk_age }}
  chunk_target_size: {{ loki_ingester_chunk_target_size }}
  chunk_encoding: snappy

compactor:
  working_directory: /var/lib/loki/compactor
  compaction_interval: 10m
  retention_enabled: true
  delete_request_store: {{ 's3' if loki_storage_type == 's3' else 'filesystem' }}

query_range:
  align_queries_with_step: true
  cache_results: {{ loki_results_cache_enabled | lower }}
  results_cache:
    cache:
      embedded_cache:
        enabled: {{ loki_results_cache_enabled | lower }}
        max_size_mb: {{ loki_results_cache_max_size_mb }}

querier:
  max_concurrent: 20

limits_config:
  ingestion_rate_mb: 50
  ingestion_burst_size_mb: 100
  max_streams_per_user: 10000
  retention_period: 744h
  allow_structured_metadata: true
  split_queries_by_interval: 15m