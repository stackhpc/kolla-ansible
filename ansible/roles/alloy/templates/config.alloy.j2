{% if enable_loki %}
loki.write "local_loki" {
  {% for host in loki_hosts.split(',') %}
    endpoint {
        url = "http://{{ host }}:{{ loki_port }}/loki/api/v1/push"
        batch_size = "1.5MiB"
    }
  {% endfor %}
}

local.file_match "kolla_logs" {
    path_targets = [
        { "__address__" = "localhost", "__path__" = "/var/log/kolla/*/*.log" },
    ]
}

loki.source.file "kolla_files" {
    targets    = local.file_match.kolla_logs.targets
    forward_to = [loki.process.labels.receiver]
}

loki.process "labels" {
    forward_to = [loki.write.local_loki.receiver]

    stage.static_labels {
        values = {
            hostname = "{{ ansible_facts.hostname }}",
        }
    }

    stage.regex {
        expression = "/var/log/kolla/(?P<service_name>[^/]+)/(?P<program_name>[^/\\.]+)"
        source     = "filename"
    }

    stage.regex {
        expression = "^(?P<ts_standard>\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d+)"
    }

    stage.timestamp {
        source   = "ts_standard"
        format   = "2006-01-02 15:04:05.000"
        location = "Local"
    }

    stage.regex {
        expression = "\\[(?P<ts_uwsgi>\\w{3} \\w{3}\\s+\\d{1,2} \\d{2}:\\d{2}:\\d{2} \\d{4})\\]"
    }

    stage.timestamp {
        source   = "ts_uwsgi"
        format   = "Mon Jan _2 15:04:05 2006"
        location = "Local"
    }

    stage.labels {
        values = {
            service_name = "service_name",
            program      = "program_name",
        }
    }

    stage.regex {
        expression = "(?i)(?P<ext_level>INFO|DEBUG|ERROR|WARN|WARNING|CRITICAL|FATAL)"
    }

    stage.template {
        source   = "ext_level"
        template = "{% raw %}{{ .Value | lower }}{% endraw %}"
    }

    stage.labels {
        values = {
            level = "ext_level",
        }
    }
}

loki.source.journal "systemd" {
    forward_to = [loki.write.local_loki.receiver]
    labels     = {
        job          = "systemd",
        hostname     = "{{ ansible_facts.hostname }}",
        service_name = "systemd",
    }
}

{% endif %}

prometheus.remote_write "prometheus" {
  {% for host in prometheus_hosts.split(',') %}
  endpoint {
    url = "https://{{ host }}:{{ prometheus_port }}/api/v1/push"
  }
  {% endfor %}
}


{% for config in prometheus_scrape_configs.scrape_configs %}
prometheus.scrape "{{ config.job_name }}" {
  {% if config.scrape_interval is defined %}
  scrape_interval = "{{ config.scrape_interval }}"
  {% else %}
  scrape_interval = "{{ prometheus_scrape_interval }}"
  {% endif %}
  {% if config.scrape_timeout is defined %}
  scrape_timeout = "{{ config.scrape_timeout }}"
  {% else %}
  scrape_timeout = "{{ prometheus_scrape_timeout }}"
  {% endif %}
  {% if config.scheme is defined %}
  scheme = "{{ config.scheme }}"
  {% endif %}
  {% if config.honor_labels is defined %}
  honor_labels = {{ config.honor_labels }}
  {% endif %}
  {% if config.basic_auth is defined %}
  basic_auth {
    username = "{{ config.basic_auth.username }}"
    password = "{{ config.basic_auth.password }}"
  }
  {% endif %}
  {% if config.metrics_path is defined %}
  metrics_path = "{{ config.metrics_path }}"
  {% endif %}
  targets = [
  {% for static_config in config.static_configs %}
    {% for target in static_config.targets %}
    {
        "__address__" = "{{ target }}",
        {% if static_config.labels is defined %}
            {% for (label, value) in static_config.labels.items() %}
        "{{ label }}" = "{{ value }}",
            {% endfor %}
        {% endif %}
    },
    {% endfor %}
  {% endfor %}
  ]
  {#  If we have relabel configs, we forward to a relabel component #}
  {% if config.relabel_configs is defined %}
  forward_to = [prometheus.relabel.{{config.job_name}}_relabel.receiver]
  {% else %} {# Otherwise, we forward straight to Prometheus #}
  forward_to = [prometheus.remote_write.prometheus.receiver]
  {% endif %}
  clustering {
    enabled = true
  }
}
{% endfor %}

# Define relabel components for any scrape configs with relabel rules
{% for config in prometheus_scrape_configs.scrape_configs %}
{% if config.relabel_configs is defined %}
prometheus.relabel.{{config.job_name}}_relabel {
    forward_to = [prometheus.remote_write.prometheus.receiver]

    {% for rule in config.relabel_configs %}
    rule {
        {% if rule.regex is defined %}
        regex = "{{ rule.regex }}"
        {% endif %}
        {% if rule.replacement is defined %}
        replacement = "{{ rule.replacement }}"
        {% endif %}
        target_label = "{{ rule.target_label }}"
        {% if rule.source_labels is defined %}
        source_labels = [
            {% for label in rule.source_labels %}
            "{{label}}"
            {% endfor %}
        ]
        {% endif %}
    }
    {% endfor %}
}
{% endif %}
{% endfor %}

livedebugging {
  enabled = true
}