{
    "command": "/usr/bin/alloy run /etc/alloy/config.alloy --storage.path=/var/lib/alloy/data --cluster.enabled --cluster.join-addresses={% for host in groups['alloy'] %}{{ 'api' | kolla_address(host) }}:12345{% if not loop.last %},{% endif %}{% endfor %}",
    "config_files": [
        {
            "source": "{{ container_config_directory }}/config.alloy",
            "dest": "/etc/alloy/config.alloy",
            "owner": "alloy",
            "perm": "0600"
        }
    ],
    "permissions": [
        {
            "path": "/var/lib/alloy/data",
            "owner": "alloy:alloy",
            "recurse": true
        }
    ]
}